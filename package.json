{
  "name": "ai-accessmate",
  "version": "1.0.0",
  "description": "AI AccessMate — AI-Powered Accessibility & Inclusion Assistant",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "render-build": "npm install && npm --prefix client install && npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "server": "node server/server.js",
    "dev": "node server/server.js",
    "migrate": "node server/scripts/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.48.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
